{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "skipFiles": [ "<node_internals>/**" ],
      "program": "${workspaceFolder}/node_modules/jest/bin/jest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "runtimeArgs": [
        "--inspect-brk",
        "${workspaceRoot}/node_modules/jest/bin/jest",
        "--runInBand",
        "--coverage=false",
        "--debug",
        "--env=jsdom",
        "--watchAll"
      ],
      "args": [
        "--runInBand",
        "--coverage=false",
        "--no-cache",
        "--debug",
        "--env=jsdom",
        "--watchAll"
      ],
      "sourceMaps": true,
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/node_modules/jest/bin/jest"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Jest Tests Debug",
      "skipFiles": [ "<node_internals>/**" ],
      "program": "./node_modules/jest/bin/jest.js",
      "args": [
        "-i"
      ],
      "preLaunchTask": "build",
      "internalConsoleOptions": "openOnSessionStart",
      "outFiles": [
        "${workspaceRoot}/dist/**/*"
      ],
      "envFile": "${workspaceRoot}/.env",
      "sourceMaps": true
    }
  ]
}